// Тот же состав, что и win11-1c.json5, плюс RDP. Отдельный vmName (не
// 'win11-1c') — сознательно: разные профили с одинаковым vmName делили
// бы один и тот же db/<vmName>/disk.qcow2, и переключение профиля на
// уже установленной VM ничего не переустановит (FirstLogonCommands
// выполняются ровно один раз, при самом первом входе) — новая фича
// просто не попадёт на уже готовый диск. Разный vmName = разные
// db/cache директории = можно ставить и сравнивать оба варианта не
// разрушая друг друга.
{
  vmName: 'win11-1c-rdp',
  features: ['winrm', 'openssh', 'serial-agent', 'rdp'],
}
