  // INSTALLDIR под C:\\Program Files\\BAF (измерено в его verbose log), а
  // не в стандартном для обычной поставки 1С каталоге 1cv8.
  installationDirectory: 'C:\\Program Files\\BAF\\8.3.19.1529',
  // Русский transform из поставки. UI установки выключен, но transform
  // фиксирует локализованные ресурсы и язык продукта.
  transformFilename: '1058.mst',
  msiProperties: ['ADDLOCAL=ALL', 'REBOOT=ReallySuppress'],
  expectedFiles: [
    {
      filename: 'BAF (x86-64).msi',
