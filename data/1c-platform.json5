// Декларация именно того дистрибутива платформы 1С, который допустимо
// установить. Исходные файлы живут в vendor/ и проверяются до отправки в
// гостя: наличие одноимённого файла с другими байтами — ошибка, не новая
// «версия по умолчанию».
{
  sourceDirectory: 'vendor/1C/BAF',
  productCode: '{00D36FCE-132B-4952-9099-0BF45B1833F5}',
  version: '8.3.19.1529',
  // Этот дистрибутив имеет ProductName "BAF (x86-64)" и сам MSI задаёт
  // INSTALLDIR под C:\\Program Files\\BAF (измерено в его verbose log), а
  // не в стандартном для обычной поставки 1С каталоге 1cv8.
  installationDirectory: 'C:\\Program Files\\BAF\\8.3.19.1529',
  // Русский transform из поставки. UI установки выключен, но transform
  // фиксирует локализованные ресурсы и язык продукта.
  transformFilename: '1058.mst',
  msiProperties: ['ADDLOCAL=ALL', 'REBOOT=ReallySuppress'],
  expectedFiles: [
    {
      filename: 'BAF (x86-64).msi',
      expectedBytes: 4853760,
      expectedSha256: '8ec049d78173e283db130ad1b5055594ea878c614994c4832ef1581cab3012f5',
    },
    {
      filename: 'Data1.cab',
      expectedBytes: 438412506,
      expectedSha256: '898e178de998496da5609d5356579481942eef9be25b8fbff5ba43b69cca0af2',
    },
    {
      filename: '1058.mst',
      expectedBytes: 155648,
      expectedSha256: 'ce98d3ca9d9b728bd7c724bb64d5ee36b95a8409238a74d7c79f32cd2e194260',
    },
    {
      filename: 'vc_redist.x64.exe',
      expectedBytes: 15311608,
      expectedSha256: '5b0cbb977f2f5253b1ebe5c9d30edbda35dbd68fb70de7af5faac6423db575b5',
    },
  ],
  // Клиент/конфигуратор 1С — единственный исполняемый файл, который
  // запускают модули (DESIGNER/ENTERPRISE), поэтому путь объявлен здесь,
  // а не собирается строкой в каждом из них.
  clientExecutableRelativePath: 'bin\\1cv8.exe',
  // Тонкий клиент используется для unattended /Execute EPF: 1cv8.exe —
  // GUI-приложение, которое может не завершаться одновременно с обработкой.
  thinClientExecutableRelativePath: 'bin\\1cv8c.exe',
  comConnectorRelativePath: 'bin\\comcntr.dll',
  requiredInstalledFiles: ['bin\\1cv8.exe', 'bin\\1cv8c.exe', 'bin\\ragent.exe', 'bin\\rac.exe', 'bin\\ras.exe', 'bin\\comcntr.dll', 'bin\\wsap24.dll'],

  // Windows показывает модальный запрос "разрешить этой программе доступ в
  // сеть?" в момент, когда программа впервые открывает слушающий сокет. Для
  // 1С это происходит при первом запуске Конфигуратора, и человек отвечает на
  // него руками -- ровно та неавтоматизированная развилка, которую запрещает
  // FULLAUTO: ответ человека становится невидимым состоянием гостя, которого
  // на чистой машине не будет.
  //
  // Файловой ИБ входящие соединения не нужны вообще, поэтому мы объявляем
  // ЯВНЫЕ запрещающие правила заранее: правило уже есть -> Windows не
  // спрашивает. Это не "закрыть доступ", а "принять решение в конфиге, а не
  // мышкой".
  firewall: {
    // NotifyOnListen выключается для всех профилей: любой другой installer
    // (Apache, техподдержка) иначе принесёт тот же самый модальный вопрос.
    suppressListenNotifications: true,
    inboundBlockRules: [
      { name: 'AutoSetup-1C-Enterprise-In-Block', displayName: 'AutoSetup 1C Enterprise (inbound, blocked)', programRelativePath: 'bin\\1cv8.exe' },
      { name: 'AutoSetup-1C-ThinClient-In-Block', displayName: 'AutoSetup 1C thin client (inbound, blocked)', programRelativePath: 'bin\\1cv8c.exe' },
    ],
  },
  guest: {
    stagingDirectory: 'C:\\ProgramData\\AutoSetup\\staging\\1c-platform',
    logDirectory: 'C:\\ProgramData\\AutoSetup\\logs',
    msiLogFilename: '1c-platform-install.log',
    rebootTimeoutMs: 300000,
    sshReconnectIntervalMs: 1000,
  },
}
