{
  // единственное место, где путь захардкожен буквально — всё остальное
  // выводится из него в src/config.js
  projectRoot: '/data/wd/aibox/wintest',
  vmName: 'win11-1c',

  network: {
    // единственное место, где объявлен loopback-адрес для всей tcp-связи
    // агент/qemu/swtpm/человек (spice, vnc, qmp) — см. CONFIG-SINGLE-SOURCE
    loopbackHost: '127.0.0.1',
  },

  windowsIso: {
    url: 'https://software-static.download.prss.microsoft.com/dbazure/888969d5-f34g-4e03-ac9d-1f9786c66749/26100.1742.240906-0331.ge_release_svc_refresh_CLIENT_LTSC_EVAL_x64FRE_en-us.iso',
    filename: '26100.1742.240906-0331.ge_release_svc_refresh_CLIENT_LTSC_EVAL_x64FRE_en-us.iso',
    expectedBytes: 5112850432,
  },

  disk: {
    format: 'qcow2',
    sizeGiB: 64,
  },

  // OVMF (UEFI firmware) ставится пакетом edk2-ovmf на Obarun. CODE — read-only
  // шаблон, используется напрямую. VARS — read-write, копируется один раз
  // per-VM в db/, чтобы состояние UEFI/secure-boot жило вместе с диском.
  ovmf: {
    // .secboot-вариант первым: Windows 11 Setup жёстко требует Secure
    // Boot, а обычный OVMF_CODE.4m.fd эту возможность прошивки физически
    // не собирает — не просто "выключено", а отсутствует как класс.
    codeTemplateCandidates: [
      '/usr/share/edk2/x64/OVMF_CODE.secboot.4m.fd',
      '/usr/share/edk2/x64/OVMF_CODE.4m.fd',
      '/usr/share/edk2-ovmf/x64/OVMF_CODE.fd',
      '/usr/share/OVMF/OVMF_CODE.fd',
    ],
    varsTemplateCandidates: [
      '/usr/share/edk2/x64/OVMF_VARS.4m.fd',
      '/usr/share/edk2-ovmf/x64/OVMF_VARS.fd',
      '/usr/share/OVMF/OVMF_VARS.fd',
    ],
    // Свежескопированный OVMF_VARS.4m.fd приходит СОВСЕМ пустым — ни
    // одной переменной (проверено эмпирически через virt-fw-vars
    // --print на этом ISO/пакете edk2-ovmf 202605-1). Значит ни PK/KEK/db,
    // ни состояния SecureBoot там нет вообще — заводим сами сразу после
    // копирования (см. src/enroll-secure-boot-keys.js).
    secureBoot: {
      binary: 'virt-fw-vars',
    },
  },

  tpm: {
    binary: 'swtpm',
    // control-канал между swtpm и qemu — ЕДИНСТВЕННОЕ осознанное исключение
    // из общего правила "tcp, не unix sockets": qemu передаёт swtpm файловый
    // дескриптор данных через CMD_SET_DATAFD (SCM_RIGHTS), а это возможность
    // ядра, которой в принципе не существует у TCP-сокетов — только у
    // AF_UNIX. swtpm и qemu-system-x86_64 всегда сидят на одном хосте
    // (obarun), никогда не пересекают границу alpine/obarun, так что unix-
    // сокет тут не нарушает мотив исходного правила (тот был про границу
    // между двумя сетевыми пространствами, которой здесь нет).
    ctrlSocketFilename: 'swtpm-ctrl.sock',
  },

  // Автоматизация установки Windows через autounattend.xml — Setup сам
  // ищет этот файл на подключённом removable-носителе, никакого выбора
  // руками. Один источник всех ответов; шаблон в
  // src/lib/render-autounattend-xml.js только подставляет эти значения.
  unattend: {
    locale: 'en-US',
    inputLocale: '0409:00000409', // US QWERTY
    timezone: 'UTC',
    // единственный образ в install.wim этого ISO (Enterprise LTSC Eval) —
    // если окажется не так, Setup явно покажет ошибку выбора образа.
    imageIndex: 1,
    // NetBIOS-имя ограничено 15 символами.
    computerName: 'WIN11-1C',
    // Не 'Administrator': встроенная учётка так называется, но она
    // отключена по умолчанию — создавать <LocalAccount> с тем же именем
    // означало бы либо конфликтовать с ней, либо городить отдельную ветку
    // шаблона под "это builtin-аккаунт". Отдельное имя с правами
    // Administrators — проще и без этой развилки.
    adminUsername: 'admin',
    // Тестовый пароль одноразовой VM: доступ только с loopback хоста
    // (SPICE/VNC/QMP/WinRM/ssh — ничего наружу не пробрасывается за
    // пределы localhost), наружу не торчит. Поменять здесь при желании —
    // единственный источник.
    adminPassword: 'ChangeMe!2026',
    enableAutoLogon: true,
    // Выполняются один раз при первом входе, по порядку. Каждый элемент —
    // имя файла в src/guest-scripts/, а не литеральная команда: содержимое
    // (реальный, читаемый PowerShell) живёт в самом .ps1-файле,
    // src/lib/build-first-logon-commands.js только оборачивает его в
    // -EncodedCommand (никакого экранирования кавычек в XML/JSON5).
    // Текущий состав — диагностический: выясняем, есть ли у гостя сеть и
    // действительно ли зависает Add-WindowsCapability, прежде чем решать,
    // как ставить ssh (см. историю задачи).
    firstLogonScripts: [
      'enable-winrm-access.ps1',
      'diagnose-guest-network.ps1',
      'probe-openssh-capability-with-timeout.ps1',
      'log-first-logon-complete.ps1',
    ],
    // Файл ответов доставляется отдельным маленьким USB-диском (removable
    // media — только там Setup его и ищет), не тем же носителем, что
    // ISO. Классический размер 1.44MB — с большим запасом под несколько
    // KB XML, максимально совместимый (см. обсуждение выбора libmount).
    answerFileDeviceId: 'answerfile0',
    answerFileFilename: 'autounattend.xml',
    answerFileImageSizeBytes: 1474560,
  },

  // Параметры guest-скриптов диагностики (src/guest-scripts/) — единый
  // источник для всего, что раньше было бы "зашитыми defaults" внутри
  // .ps1 (нарушение CONFIG-SINGLE-SOURCE/FULLCONF). Сами .ps1 — только
  // шаблоны с {{TOKEN}}, значения подставляет build-first-logon-commands.js.
  diagnostics: {
    // Тот же физический COM-порт, что и qemu.serialLogFilename на хосте —
    // единственный канал, не зависящий ни от сети гостя, ни от guest agent.
    comPort: 'COM1',
    // Проверяем именно измерением (DNS + TCP), а не предположением: есть
    // ли у гостя рабочий путь наружу вообще (публичный IP, чтобы TCP-connect
    // не зависел от DNS) и до конкретно того эндпоинта, который нужен для
    // Add-WindowsCapability -Online.
    networkProbeTargets: [
      { host: '8.8.8.8', port: 53, label: 'public-dns-ip-tcp53' },
      { host: 'download.windowsupdate.com', port: 443, label: 'windows-update-endpoint' },
    ],
    // Test-NetConnection сам себя ограничивает по времени — это верхний
    // предохранитель на весь диагностический скрипт целиком, не гадание.
    networkProbeTimeoutSeconds: 20,
    // Add-WindowsCapability -Online — единственный шаг с доказанной историей
    // зависания без таймаута (см. историю задачи). Оборачиваем в
    // Start-Job/Wait-Job с этим верхним пределом, чтобы получить
    // окончательный ответ "зависает/не зависает" и не блокировать
    // остальные FirstLogonCommands навсегда.
    capabilityProbeTimeoutSeconds: 90,
  },

  qemu: {
    binary: 'qemu-system-x86_64',
    accel: 'kvm',
    cpu: 'host',
    // Без этих флагов многоядерный Windows-гость под голым KVM может уйти
    // в livelock при межпроцессорной синхронизации (TLB shootdown/IPI):
    // N-1 vCPU крутятся в busy-spin на 100%, один простаивает, диск и
    // экран замирают — воспроизведено и измерено эмпирически (top -H:
    // 3 vCPU-потока по 99.6%, TPM спокоен, счётчики диска не двигаются).
    // Это не хак под конкретную версию Windows — стандартный базовый
    // набор Hyper-V enlightenment для любого Windows-гостя под QEMU/KVM
    // (то же самое включают по умолчанию libvirt/Proxmox). Порядок важен
    // для зависимостей QEMU: hv_synic требует hv_vpindex, hv_stimer
    // требует hv_synic.
    cpuHyperVEnlightenments: [
      'hv_relaxed',
      'hv_vapic',
      'hv_spinlocks=0x1fff',
      'hv_vpindex',
      'hv_synic',
      'hv_stimer',
      'hv_time',
    ],
    machine: 'q35',
    smp: 4,
    ramMiB: 8192,
    netDevice: 'e1000e', // нативно поддерживается Windows, без доп. драйверов

    // true = грузимся с CD (первая установка), false = грузимся с диска.
    // Явный флаг конфига, не автоопределение по факту наличия ОС на диске.
    bootFromInstaller: true,

    // id блочного устройства CD — используется и при сборке argv qemu, и
    // при опросе query-blockstats в confirm-cd-boot-prompt.js, поэтому
    // единственный источник — здесь, а не литерал в обоих местах.
    cdromDeviceId: 'cdrom0',

    // QMP (машинный протокол управления) — для скриптов/агента: screendump,
    // sendkey, graceful shutdown и т.п. tcp loopback.
    qmpPort: 4000,
    // сколько ждать (мс), пока после старта qemu-процесса не поднимется
    // QMP-listener — это ожидание локального forka/bind, а не гадание о
    // поведении гостя внутри VM (тот же класс, что ctrl-сокет swtpm).
    qmpConnectTimeoutMs: 10000,

    // Файл, в который QMP screendump сохраняет текущий кадр экрана VM —
    // рантайм-артефакт, живёт в cache/<vm>/ (см. config.js).
    screendumpFilename: 'screendump.ppm',

    // COM1 гостя пишется в этот файл на хосте (qemu -chardev file) — канал
    // диагностики, который не зависит ни от сети, ни от QMP/скриншотов:
    // guest-скрипты (см. src/guest-scripts/) пишут туда через
    // System.IO.Ports.SerialPort. Рантайм-артефакт, поэтому в cache/, не в db/.
    serialLogFilename: 'com1.log',

    // Детерминированное прохождение "Press any key to boot from CD or DVD",
    // без единой зашитой "сколько ждать"/"сколько байт" величины — только
    // форма поведения счётчика rd_bytes у cdrom (query-blockstats):
    //
    // Прошивка САМА, безусловно (даже без единого нажатия клавиши),
    // вычитывает El Torito загрузчик перед показом prompt'а — измерено
    // эмпирически: рост, затем НАВСЕГДА плоско, если клавиша не поймана.
    // При успехе картина другая: тот же начальный рост, тот же временный
    // штиль (prompt ждёт ввода), но потом чтение ВОЗОБНОВЛЯЕТСЯ (стриминг
    // boot.wim). "Перестало расти" — это сигнатура ОТКАЗА, а не успеха.
    //
    // Поэтому два шага (см. confirm-cd-boot-prompt.js):
    //  1. wait-for-stable-state — дождаться, пока фоновое чтение
    //     загрузчика затихнет (requiredStableSamples одинаковых подряд) —
    //     не важно, какого оно объёма.
    //  2. wait-for-observable-change — от этой точки отсчёта ждать ЛЮБОГО
    //     дальнейшего роста (уже без всякого порога — базовая линия
    //     честная, шум уже позади).
    //
    // maxAttempts × pollIntervalMs — верхний предохранитель на каждый шаг
    // (fail-fast при реальной поломке), не расчёт "сколько ждать".
    bootPromptConfirmation: {
      key: 'ret',
      pollIntervalMs: 300,
      requiredStableSamples: 2,
      maxAttempts: 100,
    },

    // экран для человека: 'spice' (по умолчанию — буфер обмена, ресайз,
    // меньше лагов курсора) или 'vnc'. Оба через tcp loopback.
    displayProtocol: 'spice',
    spicePort: 6900,
    vncPort: 6901,

    // проброс портов ИЗ ГОСТЯ наружу через SLIRP NAT. Это не имеет отношения
    // к общему сетевому пространству alpine/obarun — гостевая ОС всегда
    // сидит за NAT самого qemu, тут проброс обязателен.
    guestPortForwards: [
      { proto: 'tcp', hostPort: 2222, guestPort: 22 },
      { proto: 'tcp', hostPort: 5985, guestPort: 5985 },
    ],
  },
}
