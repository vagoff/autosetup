// Отдельный, воспроизводимый инструмент чтения данных из уже восстановленной
// ИБ. Исходники EPF лежат в Git; собранный EPF существует лишь во временном
// staging гостя и никогда не становится артефактом конфигурации.
{
  // Полные исходники EPF, принадлежащие нам (скопированы один раз из
  // vanessa-runner, дальше правятся руками -- инвариант OWNTHESOURCE).
  // Ничего не генерируется и не патчится: каталог целиком уезжает в staging
  // и собирается Конфигуратором как есть.
  sourceDirectory: 'features/1c-query-runner/src/epf',
  rootXmlFilename: 'ШаблонОбработки.xml',
  guest: {
    stagingDirectory: 'C:\\ProgramData\\AutoSetup\\staging\\1c-query-runner',
    logDirectory: 'C:\\ProgramData\\AutoSetup\\logs',
    buildLogFilename: '1c-query-runner-build.log',
    executionLogFilename: '1c-query-runner-execution.log',
  },
  defaultMaxRows: 1000,
  maxMaxRows: 10000,
  // Каждый запуск -- это CREATEINFOBASE compiler-инфобазы (быстро) + сборка
  // EPF Конфигуратором (~5с) + холодный старт тонкого клиента на РЕАЛЬНОЙ
  // production-копии ИБ (~30с сам по себе, до какого-либо запроса).
  // Измерено живым запуском (--select-one/--infobase-probe/--table-probe):
  // ~40с каждый под пустой нагрузкой. 120с -- трёхкратный запас, а не
  // "короткий" таймаут -- копия ИБ большая, и это стоимость входа, а не
  // сложности запроса.
  probeTimeoutSeconds: 120,
  documentsTopTimeoutSeconds: 300,
  queryTimeoutSeconds: 300,
  stopTimeoutSeconds: 30,
}
