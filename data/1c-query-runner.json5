// Отдельный, воспроизводимый инструмент чтения данных из уже восстановленной
// ИБ. Исходники EPF лежат в Git; собранный EPF существует лишь во временном
// staging гостя и никогда не становится артефактом конфигурации.
{
  sourceDirectory: 'features/1c-query-runner/src',
  // Проверенная XML-оболочка EPF из сохранённого vanessa-runner. Наша
  // бизнес-логика всё равно живёт в sourceDirectory ниже.
  templateSourceDirectory: 'vendor/vanessa-runner/epf/ШаблонОбработки',
  rootXmlFilename: 'ШаблонОбработки.xml',
  moduleRelativePath: 'ШаблонОбработки/Forms/Форма/Ext/Form/Module.bsl',
  featureBusinessLogicPath: 'QueryRunner/BusinessLogic.bsl',
  guest: {
    stagingDirectory: 'C:\\ProgramData\\AutoSetup\\staging\\1c-query-runner',
    logDirectory: 'C:\\ProgramData\\AutoSetup\\logs',
    buildLogFilename: '1c-query-runner-build.log',
    executionLogFilename: '1c-query-runner-execution.log',
  },
  defaultMaxRows: 1000,
  maxMaxRows: 10000,
  // Короткие диагностические пробы не должны удерживать VM. Полный
  // перепись документов и произвольный запрос получают отдельные лимиты.
  probeTimeoutSeconds: 10,
  documentsTopTimeoutSeconds: 300,
  queryTimeoutSeconds: 300,
  stopTimeoutSeconds: 30,
}
