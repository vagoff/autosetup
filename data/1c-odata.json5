// Декларация отдельного применяемого модуля стандартного OData для уже
// работающих Windows, платформы 1С и production-copy.
{
  publicationName: 'production-copy',
  endpointPath: 'odata/standard.odata',
  serverTimezone: 'Europe/Kyiv',
  web: {
    publicationDirectory: 'C:\\1C\\web\\production-copy',
    descriptorFilename: 'odata.vrd',
  },
  user: {
    name: 'autosetup-odata',
    passwordStateFilename: 'odata-user-password.txt',
    passwordLength: 24,
    // Имя сверено с реальной Configuration.xml BAS ERP, а не угадано из
    // англоязычной документации БСП.
    // Роли существуют в BAS ERP и проверяются probe-ом до назначения.
    // FullAccess/ПолныеПрава запрещены кодом публикатора.
    roleNames: [
      'УдаленныйДоступСтандартныйИнтерфейсOData',
      // БСП проверяет эту базовую роль в обработчиках ПередЗаписью; без неё
      // статическое право изменения документа не доходит до записи.
      'БазовыеПрава',
      'ЧтениеДоступностиРабочихЦентров',
      'ЧтениеМаршрутныхЛистовПроизводства',
      'ДобавлениеИзменениеМаршрутныхЛистовПроизводства',
      'ЧтениеПоступленийТоваровУслугВозвратовПоставщикам',
      'ДобавлениеИзменениеПоступленийТоваровУслугВозвратовПоставщикам',
      'ЧтениеВыпускаПродукции',
      'ДобавлениеИзменениеВыпускаПродукции',
      'ЧтениеЗаказовПоставщикам',
      'ДобавлениеИзменениеЗаказовПоставщикам',
      // Объекты НСИ ниже ограничены составом OData, а эта роль даёт
      // пользователю право читать именно опубликованные справочники.
      'ЧтениеНормативноСправочнойИнформации',
    ],
  },
  // Если rights отсутствует, модуль публикует все поддерживаемые типы и
  // операции. При наличии объекта ключ — имя документа метаданных, значение
  // — разрешённые OData-операции для него.
  rights: {
    ДоступностьРабочихЦентров: ['read'],
    МаршрутныйЛистПроизводства: ['read', 'update'],
    ПоступлениеТоваровУслуг: ['read', 'update'],
    ВыпускПродукции: ['read', 'update'],
    ЗаказПоставщику: ['read', 'update'],
  },
  // Явный allowlist справочников, нужных формам выбранных документов. Это
  // не выводится скрыто из метаданных: добавление нового типа всегда видно
  // и рецензируется в одном конфиге с правами документов.
  catalogRights: {
    Номенклатура: ['read'],
    Организации: ['read'],
    Партнеры: ['read'],
    Контрагенты: ['read'],
    Склады: ['read'],
  },
  publisher: {
    sourceDirectory: 'features/1c-odata-publisher/src/epf',
    rootXmlFilename: 'ПубликаторOData.xml',
    manifestFilename: 'publisher-manifest.txt',
    // Общий с 1c-query-runner раннер: "собери EPF Конфигуратором, выполни
    // тонким клиентом" -- один и тот же сценарий, см. src/guest-scripts/run-1c-epf.ps1.
    runnerScriptFilename: 'run-1c-epf.ps1',
    timeoutSeconds: 180,
  },
  demo: {
    host: '127.0.0.1',
    port: 8090,
    documentNames: ['МаршрутныйЛистПроизводства', 'ВыпускПродукции', 'ЗаказПоставщику'],
  },
  guest: {
    stagingDirectory: 'C:\\ProgramData\\AutoSetup\\staging\\1c-odata',
    logDirectory: 'C:\\ProgramData\\AutoSetup\\logs',
    publicationLogFilename: '1c-odata-publication.log',
    healthCheckTimeoutMs: 30000,
    healthCheckPollIntervalMs: 500,
  },
}
