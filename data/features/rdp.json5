// Фича: включить RDP (десктопная сессия по сети) на госте — вторая
// "фича для входа" наряду с openssh, только для человека, не для
// агента (агент ходит по SSH/serial-agent; человеку для визуальной
// проверки/экспериментов остаются SPICE/VNC по умолчанию, RDP — ещё
// один вариант входа поверх сети, а не замена).
{
  guestPortForwardName: 'rdp',
  guestScripts: {
    firstLogon: ['enable-rdp-access.ps1'],
  },
  check: {
    // Таймаут одной попытки CredSSP-логина через vendor/impacket/examples/
    // rdp_check.py (src/tools/check-rdp-login.js) — не сетевой connect,
    // а весь TLS+CredSSP handshake целиком.
    timeoutSeconds: 10,
  },
}
