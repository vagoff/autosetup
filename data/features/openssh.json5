// Фича: автономный Win32-OpenSSH + диагностика сети/Add-WindowsCapability
// перед его установкой. Официальный ZIP доставляется вместе с
// autounattend.xml на USB, поэтому установка вообще не использует
// DISM/FOD/Windows Update. URL, SHA-256 и все имена задаются здесь,
// чтобы смена версии была одним воспроизводимым изменением конфига.
{
  url: 'https://github.com/PowerShell/Win32-OpenSSH/releases/download/10.0.0.0p2-Preview/OpenSSH-Win64.zip',
  archiveFilename: 'OpenSSH-Win64.zip',
  expectedSha256: '23f50f3458c4c5d0b12217c6a5ddfde0137210a30fa870e98b29827f7b43aba5',
  installationDirectoryName: 'OpenSSH-Win64',
  serviceName: 'sshd',
  firewallRuleName: 'OpenSSH-Server-In-TCP',
  firewallRuleDisplayName: 'OpenSSH SSH Server (sshd)',
  // Порт берётся из data/vars.json5 (qemu.guestPortForwards) по этому
  // имени: порт 22 объявлен ровно один раз, и firewall гостя не сможет
  // разъехаться с пробросом QEMU.
  guestPortForwardName: 'openssh',
  adminAuthorizedKeysFilename: 'administrators_authorized_keys',
  clientKeyAlgorithm: 'rsa',
  clientKeyBits: 3072,
  clientKeyComment: 'win11-1c-automation',
  clientPrivateKeyFilename: 'openssh-client-key.pem',
  clientPublicKeyFilename: 'openssh-client-key.pub',
  check: {
    clientBinary: 'ssh',
    connectTimeoutSeconds: 20,
    remoteCommand: 'whoami',
    knownHostsFilename: 'openssh-known_hosts',
    strictHostKeyChecking: 'accept-new',
    batchMode: true,
    passwordAuthentication: false,
    keyboardInteractiveAuthentication: false,
  },
  // Проверяем именно измерением (DNS + TCP), а не предположением: есть ли
  // у гостя рабочий путь наружу вообще (публичный IP, чтобы TCP-connect
  // не зависел от DNS) и до конкретно того эндпоинта, который нужен для
  // Add-WindowsCapability -Online. Нужны только двум шагам этой же
  // фичи — diagnose-guest-network.ps1 и probe-openssh-capability-with-
  // timeout.ps1, которые бегут перед install-openssh-access.ps1.
  networkProbeTargets: [
    { host: '8.8.8.8', port: 53, label: 'public-dns-ip-tcp53' },
    { host: 'download.windowsupdate.com', port: 443, label: 'windows-update-endpoint' },
  ],
  // Test-NetConnection сам себя ограничивает по времени — верхний
  // предохранитель на весь диагностический скрипт целиком, не гадание.
  networkProbeTimeoutSeconds: 20,
  // Add-WindowsCapability -Online — единственный шаг с доказанной историей
  // зависания без таймаута (см. историю задачи). Оборачиваем в
  // Start-Job/Wait-Job с этим верхним пределом, чтобы получить
  // окончательный ответ "зависает/не зависает" и не блокировать
  // остальные FirstLogonCommands навсегда.
  capabilityProbeTimeoutSeconds: 90,
  guestScripts: {
    firstLogon: [
      'diagnose-guest-network.ps1',
      'probe-openssh-capability-with-timeout.ps1',
      'install-openssh-access.ps1',
    ],
  },
}
