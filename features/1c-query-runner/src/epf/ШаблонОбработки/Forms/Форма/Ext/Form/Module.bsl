////////////////////////////////////////////////////////////////////////////////
// ВСТРАИВАЕМАЯ ОБРАБОТКА "1C QUERY RUNNER".
//
// Происхождение: скопировано ОДИН РАЗ из vanessa-runner
// (epf/ШаблонОбработки, commit 611e79d) ровно так, как предписывает сам
// шаблон в своей инструкции "скопируйте каталог и переименуйте". С этого
// момента файл наш и правится как обычный исходник -- см. инвариант
// OWNTHESOURCE. Никакой сборки этого модуля подстановками на лету больше нет.
//
// Отличия от исходного шаблона (внесены навсегда, руками):
//   1. Регион "БизнесЛогика" реализован под наши режимы (Mode=...).
//   2. Имена параметров запуска -- ASCII (ResultFile, Exit) вместо
//      кириллических. Управляющий канал не должен зависеть от активной ANSI
//      code page Windows ВООБЩЕ, даже когда она правильная (см.
//      unattend.systemLocale в data/base.json5).
//   3. ЗаписатьФайлРезультата пишет во временный файл и переименовывает его.
//      Хост поллит файл снаружи и обязан видеть либо ничего, либо целый JSON,
//      никогда -- наполовину записанный.
//
// Запуск: 1cv8c.exe ENTERPRISE ... /Execute <epf> /C"Mode=...;ResultFile=<путь>;Exit"
////////////////////////////////////////////////////////////////////////////////

#Область ОписаниеПеременных

&НаКлиенте
Перем ПутьКОбработке; // каталог обработки (для разрешения путей вида $instrumentsRoot)

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УбратьПодтверждениеПриЗавершенииПрограммы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	СтрокаЗапуска = СокрЛП(ПараметрЗапуска);
	Если СтрокаЗапуска = "" Тогда
		Возврат;
	КонецЕсли;

	ПутьФайлаРезультата = "";
	Результат = НовыйРезультат();
	ЗавершитьРаботуСистемыЗапрошено = Ложь;

	Попытка
		ПутьКОбработке = ПолучитьПутьОбработки();

		ПараметрыЗапуска = ПолучитьСтруктуруПараметров(СтрокаЗапуска);
		ПреобразоватьПараметрыКоторыеНачинаютсяСТочкиКНормальнымПутям(ПараметрыЗапуска);

		Если ПараметрыЗапуска.Свойство("ResultFile") Тогда
			ПутьФайлаРезультата = ПараметрыЗапуска.ResultFile;
		КонецЕсли;
		ЗавершитьРаботуСистемыЗапрошено = ПараметрыЗапуска.Свойство("Exit");

		Результат = ВыполнитьОперацию(ПараметрыЗапуска);
	Исключение
		Результат.КодВозврата = 1;
		Результат.Ошибка = "Неудача при выполнении обработки: " + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Файл результата пишется при любом исходе и ДО завершения работы - это
	// достоверный для vanessa-runner источник успеха/ошибки.
	ЗаписатьФайлРезультата(ПутьФайлаРезультата, Результат);

	Если ЗавершитьРаботуСистемыЗапрошено Тогда
		ЗавершитьРаботуСистемы(Ложь, Ложь);
	Иначе
		ПрекратитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область БизнесЛогика

&НаКлиенте
Функция ВыполнитьОперацию(Знач ПараметрыЗапуска)

	Результат = НовыйРезультат();

	Попытка
		Режим = ПолучитьОбязательнуюСтроку(ПараметрыЗапуска, "Mode");
		Если Режим = "query" Тогда
			Данные = ВыполнитьЗапросНаСервере(
				ПолучитьОбязательнуюСтроку(ПараметрыЗапуска, "QueryFile"),
				ПолучитьПоложительноеЧисло(ПараметрыЗапуска, "MaxRows", 1000));
		ИначеЕсли Режим = "documents-top" Тогда
			Данные = ПосчитатьДокументыНаСервере(ПолучитьПоложительноеЧисло(ПараметрыЗапуска, "Top", 10));
		ИначеЕсли Режим = "infobase-probe" Тогда
			Данные = ПолучитьПаспортИнфобазыНаСервере();
		ИначеЕсли Режим = "table-probe" Тогда
			Данные = ПрочитатьОднуСтрокуДокументаНаСервере();
		ИначеЕсли Режим = "select-one" Тогда
			Данные = ВыполнитьSelectOneНаСервере();
		Иначе
			ВызватьИсключение "Unknown Mode: " + Режим;
		КонецЕсли;
		Результат.Сообщения.Добавить(СериализоватьJSON(Данные));
	Исключение
		Результат.КодВозврата = 1;
		Результат.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьSelectOneНаСервере()
	Запрос = Новый Запрос("ВЫБРАТЬ 1 КАК Значение");
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ВызватьИсключение "SELECT 1 returned no row";
	КонецЕсли;
	Возврат Новый Структура("ok,value,error", Истина, Выборка.Значение, "");
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьОднуСтрокуДокументаНаСервере()
	Если Метаданные.Документы.Количество() = 0 Тогда
		ВызватьИсключение "The configuration has no document types";
	КонецЕсли;
	ОбъектМетаданных = Неопределено;
	Для Каждого Кандидат Из Метаданные.Документы Цикл
		ОбъектМетаданных = Кандидат;
		Прервать;
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Документ." + ОбъектМетаданных.Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	ЕстьСтрока = Выборка.Следующий();
	Возврат Новый Структура(
		"ok,documentName,documentSynonym,hasRow,referencePresentation,error",
		Истина,
		ОбъектМетаданных.Имя,
		Строка(ОбъектМетаданных.Синоним),
		ЕстьСтрока,
		?(ЕстьСтрока, Строка(Выборка.Ссылка), ""),
		"");
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПаспортИнфобазыНаСервере()
	Возврат Новый Структура(
		"ok,configurationName,configurationSynonym,documentTypeCount,catalogTypeCount,error",
		Истина,
		Метаданные.Имя,
		Строка(Метаданные.Синоним),
		Метаданные.Документы.Количество(),
		Метаданные.Справочники.Количество(),
		"");
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьЗапросНаСервере(ФайлЗапроса, МаксимумСтрок)

	Запрос = Новый Запрос(ПрочитатьТекстUTF8(ФайлЗапроса));
	РезультатЗапроса = Запрос.Выполнить();
	Результат = Новый Структура("ok,columns,rows,truncated,error", Истина, Новый Массив, Новый Массив, Ложь, "");
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Результат.columns.Добавить(Колонка.Имя);
	КонецЦикла;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.rows.Количество() = МаксимумСтрок Тогда
			Результат.truncated = Истина;
			Прервать;
		КонецЕсли;
		СтрокаРезультата = Новый Структура;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтрокаРезультата.Вставить(Колонка.Имя, ЗначениеJSON(Выборка[Колонка.Имя]));
		КонецЦикла;
		Результат.rows.Добавить(СтрокаРезультата);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПосчитатьДокументыНаСервере(Топ)

	Счётчики = Новый ТаблицаЗначений;
	Счётчики.Колонки.Добавить("Имя");
	Счётчики.Колонки.Добавить("Синоним");
	Счётчики.Колонки.Добавить("Количество");
	Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ." + ОбъектМетаданных.Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			ВызватьИсключение "COUNT query returned no row for Document." + ОбъектМетаданных.Имя;
		КонецЕсли;
		СтрокаСчётчика = Счётчики.Добавить();
		СтрокаСчётчика.Имя = ОбъектМетаданных.Имя;
		СтрокаСчётчика.Синоним = Строка(ОбъектМетаданных.Синоним);
		СтрокаСчётчика.Количество = Выборка.Количество;
	КонецЦикла;

	Счётчики.Сортировать("Количество УБЫВ");
	ТопДокументов = Новый Массив;
	Для Каждого СтрокаСчётчика Из Счётчики Цикл
		Если ТопДокументов.Количество() = Топ Тогда
			Прервать;
		КонецЕсли;
		ТопДокументов.Добавить(Новый Структура("name,synonym,count", СтрокаСчётчика.Имя, СтрокаСчётчика.Синоним, СтрокаСчётчика.Количество));
	КонецЦикла;

	Возврат Новый Структура("ok,documents,error", Истина, ТопДокументов, "");

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьТекстUTF8(ПутьКФайлу)
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеJSON(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СериализоватьJSON(Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

&НаКлиенте
Функция ПолучитьОбязательнуюСтроку(Параметры, Имя)
	Если НЕ Параметры.Свойство(Имя) Или ПустаяСтрока(Параметры[Имя]) Тогда
		ВызватьИсключение "Missing launch parameter: " + Имя;
	КонецЕсли;
	Возврат Параметры[Имя];
КонецФункции

&НаКлиенте
Функция ПолучитьПоложительноеЧисло(Параметры, Имя, ЗначениеПоУмолчанию)
	Если НЕ Параметры.Свойство(Имя) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Значение = Число(Параметры[Имя]);
	Если Значение <= 0 Или Значение <> Цел(Значение) Тогда
		ВызватьИсключение "Launch parameter must be a positive integer: " + Имя;
	КонецЕсли;
	Возврат Значение;
КонецФункции

#КонецОбласти

#Область Инфраструктура

// --- Результат ---

// Создаёт пустой результат операции в формате, ожидаемом vanessa-runner.
//
// Возвращаемое значение:
//   Структура - КодВозврата (Число), Сообщения (Массив из Строка), Ошибка (Строка)
//
&НаКлиентеНаСервереБезКонтекста
Функция НовыйРезультат()
	Возврат Новый Структура("КодВозврата, Сообщения, Ошибка", 0, Новый Массив, "");
КонецФункции

// Добавляет сообщения из одного массива в другой (на клиенте).
&НаКлиенте
Процедура ДобавитьСообщения(Приёмник, Знач Источник)
	Для Каждого Сообщение Из Источник Цикл
		Приёмник.Добавить(Сообщение);
	КонецЦикла;
КонецПроцедуры

// Добавляет сообщения из одного массива в другой (на сервере).
&НаСервереБезКонтекста
Процедура ДобавитьСообщенияСервер(Приёмник, Знач Источник)
	Для Каждого Сообщение Из Источник Цикл
		Приёмник.Добавить(Сообщение);
	КонецЦикла;
КонецПроцедуры

// Записывает JSON-файл результата. Сервис заранее создаёт пустой файл,
// обработка перезаписывает его готовым JSON. Запись не должна прерывать
// завершение работы обработки.
//
// Параметры:
//   ПутьФайла - Строка    - путь к файлу результата (пустой - не писать)
//   Результат - Структура - КодВозврата, Сообщения, Ошибка
//
&НаСервереБезКонтекста
Процедура ЗаписатьФайлРезультата(Знач ПутьФайла, Знач Результат)

	Если ПустаяСтрока(ПутьФайла) Тогда
		Возврат;
	КонецЕсли;

	// Пишем во временный файл и переименовываем: хост поллит ПутьФайла
	// снаружи и не должен увидеть наполовину записанный JSON.
	ВременныйФайл = ПутьФайла + ".tmp";
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("КодВозврата", Результат.КодВозврата);
		Данные.Вставить("Сообщения", Результат.Сообщения);
		Данные.Вставить("Ошибка", Результат.Ошибка);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.ОткрытьФайл(ВременныйФайл, "UTF-8");
		ЗаписатьJSON(ЗаписьJSON, Данные);
		ЗаписьJSON.Закрыть();

		ПереместитьФайл(ВременныйФайл, ПутьФайла);
	Исключение
		// Сбой записи результата не должен оставить клиент 1С висеть открытым.
	КонецПопытки;

КонецПроцедуры

// --- Разбор параметров строки запуска ---

&НаКлиенте
Функция ПолучитьСтруктуруПараметров(Стр)

	Результат = Новый Структура;

	Массив = РазложитьСтрокуВМассивПодстрок(Стр, ";");
	Для каждого Элем Из Массив Цикл
		Поз = Найти(Элем, "=");
		Если Поз > 0 Тогда
			Ключ     = Лев(Элем, Поз - 1);
			Значение = Сред(Элем, Поз + 1);
			Попытка
				Результат.Вставить(СокрЛП(Ключ), СокрЛП(Значение));
			Исключение
				// некорректный ключ - пропускаем
			КонецПопытки;
		Иначе
			Если НЕ ПустаяСтрока(Элем) Тогда
				Попытка
					Результат.Вставить(СокрЛП(Элем), Истина);
				Исключение
					// некорректный флаг - пропускаем
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",",
		Знач ПропускатьПустыеСтроки = Неопределено)

	Результат = Новый Массив;

	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Строка) Тогда
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;

	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПреобразоватьПараметрыКоторыеНачинаютсяСТочкиКНормальнымПутям(СтруктураПараметров)

	МассивКлючей = Новый Массив;
	Для каждого ПараметрБилда Из СтруктураПараметров Цикл
		Если Лев(ПараметрБилда.Значение, 1) = "." Или Найти(ПараметрБилда.Значение, "$instrumentsRoot") > 0 Тогда
			МассивКлючей.Добавить(ПараметрБилда.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для каждого Ключ Из МассивКлючей Цикл
		Стало = ПреобразоватьПутьСТочкамиКНормальномуПути(СтруктураПараметров[Ключ]);
		Стало = ЗаменитьСлеши(Стало);
		СтруктураПараметров.Вставить(Ключ, Стало);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПреобразоватьПутьСТочкамиКНормальномуПути(ОригСтр)

	Если Найти(ОригСтр, "$instrumentsRoot") > 0 И НЕ ПустаяСтрока(ПутьКОбработке) Тогда
		Возврат СтрЗаменить(ОригСтр, "$instrumentsRoot", ДополнитьСлешВПуть(ПутьКОбработке));
	КонецЕсли;

	Возврат ОригСтр;

КонецФункции

&НаКлиенте
Функция ДополнитьСлешВПуть(Знач Каталог)

	Разделитель = ПолучитьРазделительПути();
	Если ПустаяСтрока(Каталог) Тогда
		Возврат Каталог;
	КонецЕсли;
	Если Прав(Каталог, 1) <> Разделитель Тогда
		Каталог = Каталог + Разделитель;
	КонецЕсли;
	Возврат Каталог;

КонецФункции

&НаКлиенте
Функция ЗаменитьСлеши(Знач Путь)
	Результат = СтрЗаменить(Путь, "\", ПолучитьРазделительПути());
	Результат = СтрЗаменить(Результат, "/", ПолучитьРазделительПути());
	Возврат Результат;
КонецФункции

// --- Путь к обработке ---

&НаКлиенте
Функция ПолучитьПутьОбработки()

	Перем ФайлПути, Результат;

	Результат = ПолучитьПутьКОбработкеСервер();
	Если НЕ ПустаяСтрока(ПутьКОбработке) Тогда
		ФайлПути = Новый Файл(ПутьКОбработке);
		Результат = ФайлПути.Путь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьПутьКОбработкеСервер()

	ОбъектНаСервере = ОбъектНаСервере();
	ИспользуемоеИмяФайла = ОбъектНаСервере.ИспользуемоеИмяФайла;
	ПрефиксИмени = НРег(Лев(ИспользуемоеИмяФайла, 6));
	Если (ПрефиксИмени <> "e1cib/") И (ПрефиксИмени <> "e1cib\") Тогда
		Возврат ИспользуемоеИмяФайла;
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервере
Функция ОбъектНаСервере()
	Возврат РеквизитФормыВЗначение("Объект");
КонецФункции

// --- Завершение работы ---

&НаСервере
Процедура УбратьПодтверждениеПриЗавершенииПрограммы()

	Если Метаданные.Подсистемы.Найти("СтандартныеПодсистемы") <> Неопределено Тогда
		МодульОбщегоНазначения = Вычислить("ОбщегоНазначения");
		Попытка
			МодульОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ОбщиеНастройкиПользователя",
				"ЗапрашиватьПодтверждениеПриЗавершенииПрограммы", Ложь);
		Исключение
			// Данного модуля и метода может не быть в конфигурации
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
