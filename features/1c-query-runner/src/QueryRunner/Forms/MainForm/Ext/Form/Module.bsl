// Внешняя обработка запускается только через ENTERPRISE /Execute.
// Принимает в ПараметрЗапуска строку:
//   Mode=query;QueryFile=C:\\...;ResultFile=C:\\...;MaxRows=1000
// либо:
//   Mode=documents-top;ResultFile=C:\\...;Top=10

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Симметричный lifecycle managed form, как у шаблона vanessa-runner.
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

    ЗаписатьМаркерОткрытияНаСервере();
    Параметры = РазобратьПараметрЗапуска(ПараметрЗапуска);
    ФайлРезультата = "";

    Попытка
        ФайлРезультата = ПолучитьОбязательнуюСтроку(Параметры, "ResultFile");
        Режим = ПолучитьОбязательнуюСтроку(Параметры, "Mode");
        Если Режим = "query" Тогда
            ФайлЗапроса = ПолучитьОбязательнуюСтроку(Параметры, "QueryFile");
            МаксимумСтрок = ПолучитьПоложительноеЧисло(Параметры, "MaxRows", 1000);
            ВыполнитьЗапросИЗаписатьРезультатНаСервере(ФайлЗапроса, ФайлРезультата, МаксимумСтрок);
        ИначеЕсли Режим = "documents-top" Тогда
            Топ = ПолучитьПоложительноеЧисло(Параметры, "Top", 10);
            ПосчитатьДокументыИЗаписатьРезультатНаСервере(ФайлРезультата, Топ);
        Иначе
            ВызватьИсключение "Неизвестный Mode: " + Режим;
        КонецЕсли;
    Исключение
        ЗаписатьОшибкуНаСервере(ФайлРезультата, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    ЗавершитьРаботуСистемы(Ложь, Ложь);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьМаркерОткрытияНаСервере()
    Запись = Новый ЗаписьТекста("C:\\ProgramData\\AutoSetup\\logs\\1c-query-runner-form-open.marker", "UTF-8");
    Запись.Записать(ТекущаяДата());
    Запись.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыполнитьЗапросИЗаписатьРезультатНаСервере(ФайлЗапроса, ФайлРезультата, МаксимумСтрок)

    Результат = Новый Структура("ok,columns,rows,truncated,error", Ложь, Новый Массив, Новый Массив, Ложь, "");
    Попытка
        ТекстЗапроса = ПрочитатьТекстUTF8(ФайлЗапроса);
        Если ПустаяСтрока(ТекстЗапроса) Тогда
            ВызватьИсключение "QueryFile пуст";
        КонецЕсли;

        Запрос = Новый Запрос(ТекстЗапроса);
        РезультатЗапроса = Запрос.Выполнить();

        Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
            Результат.columns.Добавить(Колонка.Имя);
        КонецЦикла;

        Выборка = РезультатЗапроса.Выбрать();
        Пока Выборка.Следующий() Цикл
            Если Результат.rows.Количество() = МаксимумСтрок Тогда
                Результат.truncated = Истина;
                Прервать;
            КонецЕсли;

            СтрокаРезультата = Новый Структура;
            Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
                СтрокаРезультата.Вставить(Колонка.Имя, ЗначениеJSON(Выборка[Колонка.Имя]));
            КонецЦикла;
            Результат.rows.Добавить(СтрокаРезультата);
        КонецЦикла;
        Результат.ok = Истина;
    Исключение
        Результат.error = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    ОпубликоватьJSONАтомарно(ФайлРезультата, Результат);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПосчитатьДокументыИЗаписатьРезультатНаСервере(ФайлРезультата, Топ)

    Результат = Новый Структура("ok,documents,error", Ложь, Новый Массив, "");
    Счётчики = Новый ТаблицаЗначений;
    Счётчики.Колонки.Добавить("Имя");
    Счётчики.Колонки.Добавить("Синоним");
    Счётчики.Колонки.Добавить("Количество");

    Попытка
        Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
            Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ." + ОбъектМетаданных.Имя);
            Выборка = Запрос.Выполнить().Выбрать();
            Если НЕ Выборка.Следующий() Тогда
                ВызватьИсключение "COUNT-запрос не вернул строку для Документ." + ОбъектМетаданных.Имя;
            КонецЕсли;

            СтрокаСчётчика = Счётчики.Добавить();
            СтрокаСчётчика.Имя = ОбъектМетаданных.Имя;
            СтрокаСчётчика.Синоним = Строка(ОбъектМетаданных.Синоним);
            СтрокаСчётчика.Количество = Выборка.Количество;
        КонецЦикла;

        Счётчики.Сортировать("Количество УБЫВ");
        Отобрано = 0;
        Для Каждого СтрокаСчётчика Из Счётчики Цикл
            Если Отобрано = Топ Тогда
                Прервать;
            КонецЕсли;
            Результат.documents.Добавить(Новый Структура("name,synonym,count", СтрокаСчётчика.Имя, СтрокаСчётчика.Синоним, СтрокаСчётчика.Количество));
            Отобрано = Отобрано + 1;
        КонецЦикла;
        Результат.ok = Истина;
    Исключение
        Результат.error = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    ОпубликоватьJSONАтомарно(ФайлРезультата, Результат);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеJSON(Значение)

    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    ТипЗначения = ТипЗнч(Значение);
    Если ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Дата") Тогда
        Возврат Значение;
    КонецЕсли;

    Возврат Строка(Значение);

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьТекстUTF8(ПутьКФайлу)

    Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
    Попытка
        Возврат Чтение.Прочитать();
    Наконец
        Чтение.Закрыть();
    КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьJSONВФайл(ПутьКФайлу, Значение)

    Запись = Новый ЗаписьJSON;
    Попытка
        Запись.ОткрытьФайл(ПутьКФайлу, "UTF-8");
        ЗаписатьJSON(Запись, Значение);
    Наконец
        Запись.Закрыть();
    КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОпубликоватьJSONАтомарно(ПутьКФайлу, Значение)

    ВременныйФайл = ПутьКФайлу + ".tmp";
    ЗаписатьJSONВФайл(ВременныйФайл, Значение);
    ПереместитьФайл(ВременныйФайл, ПутьКФайлу);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьОшибкуНаСервере(ФайлРезультата, ТекстОшибки)
    Если ПустаяСтрока(ФайлРезультата) Тогда
        Возврат;
    КонецЕсли;
    ОпубликоватьJSONАтомарно(ФайлРезультата, Новый Структура("ok,error", Ложь, ТекстОшибки));
КонецПроцедуры

&НаКлиенте
Функция РазобратьПараметрЗапуска(Значение)

    Результат = Новый Структура;
    Для Каждого Часть Из РазложитьСтрокуВМассивПодстрок(Строка(Значение), ";") Цикл
        Позиция = Найти(Часть, "=");
        Если Позиция > 1 Тогда
            Результат.Вставить(СокрЛП(Лев(Часть, Позиция - 1)), СокрЛП(Сред(Часть, Позиция + 1)));
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;

КонецФункции

&НаКлиенте
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель)

    Результат = Новый Массив;
    Позиция = Найти(Строка, Разделитель);
    Пока Позиция > 0 Цикл
        Результат.Добавить(Лев(Строка, Позиция - 1));
        Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
        Позиция = Найти(Строка, Разделитель);
    КонецЦикла;
    Результат.Добавить(Строка);
    Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПолучитьОбязательнуюСтроку(Параметры, Имя)
    Если НЕ Параметры.Свойство(Имя) Или ПустаяСтрока(Параметры[Имя]) Тогда
        ВызватьИсключение "Отсутствует параметр запуска: " + Имя;
    КонецЕсли;
    Возврат Параметры[Имя];
КонецФункции

&НаКлиенте
Функция ПолучитьПоложительноеЧисло(Параметры, Имя, ЗначениеПоУмолчанию)
    Если НЕ Параметры.Свойство(Имя) Тогда
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;
    Значение = Число(Параметры[Имя]);
    Если Значение <= 0 Или Значение <> Цел(Значение) Тогда
        ВызватьИсключение "Параметр запуска " + Имя + " должен быть положительным целым числом";
    КонецЕсли;
    Возврат Значение;
КонецФункции
