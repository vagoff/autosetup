// Этот EPF намеренно делает одно действие: применяет состав стандартного
// OData и пользователя ИБ по манифесту, подготовленному host-side модулем.
// Конфигурация BAS ERP не модифицируется.
//
// Права CRUD в 1С -- статические роли конфигурации (см. doc/1c-demo-requirements.md
// и ограничение платформы, на которое там есть ссылка): внешняя обработка не
// может выдать точечное право "Изменение только на этот документ", она может
// только НАЗНАЧИТЬ уже существующие роли. Поэтому "rights"/"catalogRights" в
// конфиге -- это ДЕКЛАРАЦИЯ ожидания, а не выдача прав, и этот модуль сверяет
// её с тем, что реально дают назначенные роли через глобальную функцию
// ПравоДоступа(Право, ОбъектМетаданных, Роль) -- см. ПроверитьПраваРолей.
// Недостаточное право -- фатальная ошибка (манифест лжёт о доступном),
// избыточное право -- предупреждение в результате, а не тихое умолчание
// (роли в BAS ERP связаны по предметной области и почти всегда шире одного
// документа, см. doc/1c-notes.md).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УбратьПодтверждениеПриЗавершенииПрограммы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПутьРезультата = ИзвлечьПутьРезультата(ПараметрЗапуска);
	Если ПустаяСтрока(ПутьРезультата) Тогда
		ВызватьИсключение "OData publisher launch parameter is missing: ResultFile";
	КонецЕсли;
	Результат = НовыйРезультат();
	Попытка
		ПараметрыЗапуска = РазобратьПараметры(ПараметрЗапуска);
		Режим = ПолучитьПараметр(ПараметрыЗапуска, "Mode");
		Если Режим = "probe" Тогда
			Результат = ПроверитьЗапускНаСервере(ПутьРезультата);
		ИначеЕсли Режим = "apply" Тогда
			Результат = ПрименитьМанифестНаСервере(ПолучитьПараметр(ПараметрыЗапуска, "Manifest"));
		Иначе
			ВызватьИсключение "Unknown OData publisher Mode: " + Режим;
		КонецЕсли;
	Исключение
		Результат.error = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗаписатьРезультат(ПутьРезультата, Результат);
	ЗавершитьРаботуСистемы(Ложь, Ложь);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НовыйРезультат()
	Возврат Новый Структура("ok,error,metadataNames,user,roles,warnings", Ложь, "", Новый Массив, "", Новый Массив, Новый Массив);
КонецФункции

&НаКлиенте
Функция ИзвлечьПутьРезультата(СтрокаЗапуска)
	НачалоПараметра = Найти(СтрокаЗапуска, "ResultFile=");
	Если НачалоПараметра = 0 Тогда Возврат ""; КонецЕсли;
	Значение = Сред(СтрокаЗапуска, НачалоПараметра + СтрДлина("ResultFile="));
	КонецПараметра = Найти(Значение, ";");
	Если КонецПараметра > 0 Тогда Значение = Лев(Значение, КонецПараметра - 1); КонецЕсли;
	Возврат СокрЛП(Значение);
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьЗапускНаСервере(Знач ПутьРезультата)
	Результат = НовыйРезультат();
	Результат.ok = Истина;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПрименитьМанифестНаСервере(ПутьМанифеста)
	Манифест = ПрочитатьМанифест(ПутьМанифеста);

	Состав = Новый Массив;
	Для Каждого ПолноеИмя Из Манифест.Types Цикл
		Состав.Добавить(НайтиОбъектМетаданныхИлиИсключение(ПолноеИмя));
	КонецЦикла;
	УстановитьСоставСтандартногоИнтерфейсаOData(Состав);

	СписокРолей = Новый Массив;
	Для Каждого ИмяРоли Из Манифест.Roles Цикл
		РольМетаданных = Метаданные.Роли.Найти(ИмяРоли);
		Если РольМетаданных = Неопределено Тогда ВызватьИсключение "OData role was not found: " + ИмяРоли; КонецЕсли;
		СписокРолей.Добавить(РольМетаданных);
	КонецЦикла;

	Предупреждения = ПроверитьПраваРолей(Манифест.Rights, СписокРолей);

	Пользователь = Неопределено;
	Для Каждого Кандидат Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если Кандидат.Имя = Манифест.User Тогда Пользователь = Кандидат; Прервать; КонецЕсли;
	КонецЦикла;
	Если Пользователь = Неопределено Тогда Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя(); КонецЕсли;
	Пользователь.Имя = Манифест.User;
	Пользователь.ПолноеИмя = Манифест.User;
	Пользователь.АутентификацияСтандартная = Истина;
	Пользователь.ПоказыватьВСпискеВыбора = Ложь;
	Пользователь.Пароль = Манифест.Password;
	Пользователь.Роли.Очистить();
	Для Каждого РольМетаданных Из СписокРолей Цикл
		Пользователь.Роли.Добавить(РольМетаданных);
	КонецЦикла;
	Пользователь.Записать();

	Результат = НовыйРезультат();
	Результат.ok = Истина;
	Результат.metadataNames = Манифест.Types;
	Результат.user = Манифест.User;
	Результат.roles = Манифест.Roles;
	Результат.warnings = Предупреждения;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиОбъектМетаданныхИлиИсключение(ПолноеИмя)
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение "OData metadata object was not found: " + ПолноеИмя;
	КонецЕсли;
	Возврат ОбъектМетаданных;
КонецФункции

// Возвращает соответствие "op из конфига" -> "Право платформы". Набор должен
// совпадать с allowedOperations в publish-1c-odata.js.
&НаСервереБезКонтекста
Функция СоответствиеПравOData()
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("read", "Чтение");
	Соответствие.Вставить("create", "Добавление");
	Соответствие.Вставить("update", "Изменение");
	Соответствие.Вставить("delete", "Удаление");
	Возврат Соответствие;
КонецФункции

// Сверяет декларацию rights/catalogRights из конфига с тем, что РЕАЛЬНО дают
// назначенные статические роли. ПравоДоступа() -- ГЛОБАЛЬНАЯ функция
// платформы (не метод объекта роли -- это была первая, неверная попытка,
// см. git-историю), третий необязательный параметр -- конкретная роль или
// пользователь ИБ, для которых проверяется право на объект метаданных.
//
// Недостающее право -- исключение (манифест обещает то, чего нет). Лишнее
// право (какая-то из ролей шире декларации) -- предупреждение в результате,
// а не тихое умолчание: платформа не даёт выдать точечное право только на
// нужный документ, и по-другому собрать эти роли для BAS ERP нельзя (см.
// заголовок файла).
&НаСервереБезКонтекста
Функция ПроверитьПраваРолей(Знач СтрокиПрав, Знач СписокРолей)
	Предупреждения = Новый Массив;
	Соответствие = СоответствиеПравOData();
	Для Каждого СтрокаПрава Из СтрокиПрав Цикл
		Позиция = Найти(СтрокаПрава, ":");
		Если Позиция = 0 Тогда ВызватьИсключение "OData publisher manifest has a malformed RIGHT line: " + СтрокаПрава; КонецЕсли;
		ПолноеИмя = Лев(СтрокаПрава, Позиция - 1);
		ОбъектМетаданных = НайтиОбъектМетаданныхИлиИсключение(ПолноеИмя);
		ЗапрошенныеОперации = СтрРазделить(Сред(СтрокаПрава, Позиция + 1), ",");

		Для Каждого Пара Из Соответствие Цикл
			Операция = Пара.Ключ;
			Право = Пара.Значение;
			Запрошено = ЗапрошенныеОперации.Найти(Операция) <> Неопределено;

			Дано = Ложь;
			Для Каждого РольМетаданных Из СписокРолей Цикл
				Если ПравоДоступа(Право, ОбъектМетаданных, РольМетаданных) Тогда
					Дано = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если Запрошено И НЕ Дано Тогда
				ВызватьИсключение "OData right '" + Операция + "' on " + ПолноеИмя
					+ " is declared in rights/catalogRights but no assigned role grants it";
			ИначеЕсли (НЕ Запрошено) И Дано Тогда
				Предупреждения.Добавить(ПолноеИмя + ": assigned roles also grant '" + Операция + "', which is not declared");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Предупреждения;
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьМанифест(Путь)
	Результат = Новый Структура("User,Password,Types,Roles,Rights", "", "", Новый Массив, Новый Массив, Новый Массив);
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Пока Истина Цикл
		Строка = Чтение.ПрочитатьСтроку();
		Если Строка = Неопределено Тогда Прервать; КонецЕсли;
		Позиция = Найти(Строка, "=");
		Если Позиция = 0 Тогда Продолжить; КонецЕсли;
		Ключ = Лев(Строка, Позиция - 1); Значение = Сред(Строка, Позиция + 1);
		Если Ключ = "USER" Тогда Результат.User = Значение;
		ИначеЕсли Ключ = "PASSWORD" Тогда Результат.Password = Значение;
		ИначеЕсли Ключ = "TYPE" Тогда Результат.Types.Добавить(Значение);
		ИначеЕсли Ключ = "ROLE" Тогда Результат.Roles.Добавить(Значение);
		ИначеЕсли Ключ = "RIGHT" Тогда Результат.Rights.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Если ПустаяСтрока(Результат.User) Или ПустаяСтрока(Результат.Password) Или Результат.Types.Количество() = 0
			Или Результат.Roles.Количество() = 0 Или Результат.Rights.Количество() = 0 Тогда
		ВызватьИсключение "OData publisher manifest is incomplete";
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция РазобратьПараметры(СтрокаЗапуска)
	Результат = Новый Структура;
	Для Каждого Элемент Из СтрРазделить(СтрокаЗапуска, ";") Цикл
		Позиция = Найти(Элемент, "=");
		Если Позиция > 0 Тогда Результат.Вставить(СокрЛП(Лев(Элемент, Позиция - 1)), СокрЛП(Сред(Элемент, Позиция + 1))); КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПолучитьПараметр(Параметры, Имя)
	Если НЕ Параметры.Свойство(Имя) Или ПустаяСтрока(Параметры[Имя]) Тогда
		ВызватьИсключение "OData publisher launch parameter is missing: " + Имя;
	КонецЕсли;
	Возврат Параметры[Имя];
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьРезультат(Путь, Результат)
	ВременныйПуть = Путь + ".tmp";
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ВременныйПуть, "UTF-8");
	ЗаписатьJSON(Запись, Результат);
	Запись.Закрыть();
	ПереместитьФайл(ВременныйПуть, Путь);
КонецПроцедуры

&НаСервере
Процедура УбратьПодтверждениеПриЗавершенииПрограммы()
	Если Метаданные.Подсистемы.Найти("СтандартныеПодсистемы") = Неопределено Тогда Возврат; КонецЕсли;
	Попытка
		МодульОбщегоНазначения = Вычислить("ОбщегоНазначения");
		МодульОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ОбщиеНастройкиПользователя", "ЗапрашиватьПодтверждениеПриЗавершенииПрограммы", Ложь);
	Исключение
		// Конкретная БСП может не предоставлять эту настройку.
	КонецПопытки;
КонецПроцедуры
