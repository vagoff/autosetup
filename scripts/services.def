// One service per VM profile, on purpose: a process-manager service is a definition, not
// a template -- `a pm start --name qemu-win11-1c` needs no way to pass a profile at
// start time, because the profile is part of what that name means.
//
// Each VM gets the same three-rung probe ladder (order is priority, see
// /data/wd/aibox/dev-env/tools/process-manager/doc/PROBES.md):
//   1. tcp-probe    -- is anything listening on the QMP port at all;
//   2. qmp-probe    -- is it a qemu whose machine is `running` and whose `-name` is *this*
//                      VM (qemu.vmName = the profile's vmName, see src/configure.js);
//   3. serial-shutdown -- `shutdown.exe /s /t 0` through the SYSTEM COM2 agent:
//                         explicit Windows shutdown, independent of the flaky ACPI-button
//                         policy; QMP probes below still confirm QEMU actually exited.
// `stop_timeout_sec` is what makes the graceful path real: the manager's global sleep_before_kill_sec
// is a fraction of a second, and Windows needs tens of seconds -- see the same PROBES.md.
// It matches qemu.guestShutdownTimeoutMs (180000) in data/base.json5, which is the same
// number for the same reason on the src/verbs/orchestrators/shutdown-guest.js path.

{profile: name = any_qemu
    {plugin: name=tcp_probe require="/data/wd/aibox/dev-env/tools/process-manager/src/plugins/tcp-probe/tcp-probe.js" projection=TcpProbe options {port=4000}}
    {plugin: name=qmp_probe require="/data/wd/aibox/dev-env/tools/process-manager/src/plugins/qmp-probe/qmp-probe.js" projection=QmpProbe options {port=4000; vm_name="win11-1c"}}
    {plugin: name=serial_command_probe require="/data/wd/aibox/autosetup/src/services/pm-plugins/serial-command-probe.js" projection=SerialCommandProbe options {port=4003; probe_command="ver"}}
    // Сохраняем как документированный альтернативный transport, но НЕ
    // включаем: QMP acknowledged system_powerdown не гарантирует delivery
    // гостю. На этой Windows он наблюдался как hibernate или как полный
    // no-op при том же `answered`, после чего PM доходил до SIGINT.
    // {plugin: name=qmp_graceful require="/data/wd/aibox/dev-env/tools/process-manager/src/plugins/qmp-graceful/qmp-graceful.js" projection=QmpGraceful options {port=4000}}
    {plugin: name=serial_shutdown require="/data/wd/aibox/autosetup/src/services/pm-plugins/serial-command-graceful.js" projection=SerialCommandGraceful options {port=4003; command="shutdown.exe /s /t 0"}}
}

{service:
    name = "qemu-win11-1c"
    command = "node /data/wd/aibox/autosetup/src/services/run-vm-cli.js --profile win11-1c"
    // [!] add class = nodejs_foreground_server so no "node" need to be mentioned in "command"
    profile = any_qemu // [!] separate class, subclass and instance
    // no minimum: rung 2 proves the VM is up, and anything that fails before qemu even
    // exists (missing disk, bad profile) is caught by the child's own exit
    min_uptime_sec = 0.4
    stop_timeout_sec = 180
}
